{
  "name": "hydrogen-web",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive hydrogen-orbital and probability-current visualizer over the shared GLSL ES renderer.",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs && node scripts/bake-loading-runtime.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/bake-loading-runtime.mjs",
    "build": "next build",
    "bake:loading": "node scripts/bake-loading.mjs",
    "shot": "node scripts/shot.mjs",
    "perf": "node scripts/perf.mjs",
    "check:renderer": "node scripts/check-renderer.mjs",
    "check:loading": "node scripts/check-loading.mjs",
    "check:assets": "node --experimental-strip-types scripts/check-assets.mjs",
    "bake:loading-runtime": "node scripts/bake-loading-runtime.mjs",
    "check:loading-reference": "node scripts/check-loading-reference.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twgl.js": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.50.0",
    "typescript": "^5"
  }
}
